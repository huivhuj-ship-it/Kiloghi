* { margin: 0; padding: 0; box-sizing: border-box; } html { scroll-behavior: smooth; } body { font-family: Arial, sans-serif; background: #f2f2f2; color: #222; } /* HEADER */ header { height: 80px; background: #222; color: white; display: flex; align-items: center; justify-content: space-between; padding: 0 60px; position: sticky; top: 0; z-index: 10; } .logo { font-size: 25px; font-weight: bold; } nav { display: flex; gap: 30px; } nav a { color: white; text-decoration: none; font-size: 18px; } nav a:hover { color: #aaa; } /* ЭКРАНЫ */ .screen { min-height: 100vh; padding: 80px 10%; display: flex; align-items: center; } /* ГЛАВНАЯ */ .home { background: white; } .content { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 60px; } .text { width: 50%; } .text h1, .text h2, .works h2 { font-size: 45px; margin-bottom: 25px; } .text p { font-size: 19px; line-height: 1.6; margin-bottom: 15px; } .image { width: 45%; } .image img { width: 100%; height: 350px; object-fit: cover; border-radius: 15px; } /* О НАС */ .about { background: #e7e7e7; } .reverse { flex-direction: row-reverse; } /* РАБОТЫ */ .works { display: block; text-align: center; background: white; } .description { font-size: 19px; margin-bottom: 40px; } .cards { display: flex; justify-content: center; gap: 30px; } .card { width: 30%; background: #eeeeee; padding-bottom: 25px; border-radius: 15px; overflow: hidden; } .card img { width: 100%; height: 220px; object-fit: cover; } .card h3 { font-size: 24px; margin: 20px 0 10px; } .card p { padding: 0 15px; line-height: 1.5; } /* FOOTER */ footer { background: #222; color: white; display: flex; justify-content: space-around; padding: 50px 10%; } .footer-block { width: 30%; } .footer-block h3 { font-size: 22px; margin-bottom: 15px; } .footer-block p { margin-bottom: 8px; } .footer-block a { color: white; text-decoration: none; } .footer-block a:hover { color: #aaa; } /* МОБИЛЬНАЯ ВЕРСИЯ */ @media (max-width: 768px) { header { padding: 0 20px; } nav { gap: 10px; } nav a { font-size: 14px; } .content, .reverse { flex-direction: column; } .text, .image { width: 100%; } .cards { flex-direction: column; align-items: center; } .card { width: 90%; } footer { flex-direction: column; gap: 30px; } .footer-block { width: 100%; } }
